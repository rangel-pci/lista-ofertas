# Conexão do Postgres usada pela API e pelas migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lista_ofertas"

# Chave do webhook de sincronização. Sem ela configurada, nenhuma chamada ao
# webhook é autorizada (o endpoint responde 401).
WEBHOOK_SECRET="troque-por-uma-chave-forte"

# Porta e host da API.
PORT=3001
HOST=0.0.0.0

# URL da API usada pelo frontend (server-side e navegador).
API_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"

# Banco usado apenas pelos testes de integração. Independente de DATABASE_URL
# de propósito: a suíte apaga linhas entre testes.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lista_ofertas_test"
