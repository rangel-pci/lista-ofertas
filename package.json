{
  "name": "lista-ofertas",
  "private": true,
  "description": "Mineração e listagem pública de promoções de mercados. Monorepo (npm workspaces).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run --workspace vitest.workspace.ts --reporter=default --reporter=junit --outputFile=.factory/reports/junit.xml",
    "test:watch": "vitest --workspace vitest.workspace.ts",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
